POSTGRES_USER=transferscout
POSTGRES_PASSWORD=transferscout
POSTGRES_DB=transferscout
POSTGRES_PORT=5432

DATABASE_URL=postgres://transferscout:transferscout@localhost:5432/transferscout?sslmode=disable

# API_PORT is the local-dev override; in production (Cloud Run), the
# platform-injected PORT env var takes precedence over this.
API_PORT=8080

# Ingest worker (cmd/ingest) is a one-shot batch job — schedule it
# externally (Cloud Scheduler -> Cloud Run Job in production; cron/systemd
# timer locally). No poll-interval env var; cadence is owned by the
# scheduler, not the binary.

# Extraction worker (cmd/extract). Calls the Anthropic Messages API.
# Falls back to a stub (no articles extracted) if EXTRACT_API_KEY is empty.
EXTRACT_MODEL=claude-haiku-4-5-20251001
EXTRACT_API_KEY=

TRANSFER_WINDOW=summer-2026

# Auth (cmd/api only — cmd/ingest/cmd/extract don't set or need these).
# AUTH_JWT_SECRET signs the Transfer-Scout session JWT issued after a
# successful Google sign-in. GOOGLE_CLIENT_ID is the OAuth Client ID the
# API verifies incoming Google ID tokens' audience against — it MUST
# exactly match transfer-scout-web's AUTH_GOOGLE_ID; a mismatch fails
# silently with a generic 401 on every login attempt.
AUTH_JWT_SECRET=
GOOGLE_CLIENT_ID=
