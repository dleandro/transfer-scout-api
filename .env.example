POSTGRES_USER=transferscout
POSTGRES_PASSWORD=transferscout
POSTGRES_DB=transferscout
POSTGRES_PORT=5432

DATABASE_URL=postgres://transferscout:transferscout@localhost:5432/transferscout?sslmode=disable

# API_PORT is the local-dev override; in production (Cloud Run), the
# platform-injected PORT env var takes precedence over this.
API_PORT=8080

# Workers. Production schedules one job, cmd/pipeline, which runs ingest
# then extract in one process (Cloud Scheduler -> Cloud Run Job; cron/
# systemd timer locally). cmd/ingest and cmd/extract run a single stage.
# No poll-interval env var; cadence is owned by the scheduler, not the
# binary.

# Extraction stage (cmd/pipeline, or cmd/extract alone). Each article is
# first classified by Jev (TypeSafe System One); only articles at or above
# JEV_MIN_PROBABILITY are sent on to the Anthropic Messages API.
# Falls back to a stub (no articles extracted) if EXTRACT_API_KEY is empty.
# Refuses to start if EXTRACT_API_KEY is set but TYPESAFE_API_KEY is not —
# Claude is never called ungated.
EXTRACT_MODEL=claude-haiku-4-5-20251001
EXTRACT_API_KEY=
# Floor an extraction's self-reported field confidence must clear to be
# stored, 0-1. Out-of-range or unparseable values fall back to the default.
# This only drops rumours whose details the model distrusts — the
# is_transfer_rumour flag, not this number, is what keeps non-rumours out.
# Provisional until measured against a labelled set; see
# internal/extract/eval_test.go.
EXTRACT_MIN_CONFIDENCE=0.4
# Most articles one run sends to the model. A run drains the unprocessed
# queue in batches of 50 until it is empty or this cap is hit; hitting it
# with articles still queued logs a warning. Non-positive or unparseable
# values fall back to the default, 500.
EXTRACT_MAX_ARTICLES_PER_RUN=500

# Jev classifier gate in front of Claude.
TYPESAFE_API_KEY=
# Pinned version, not jev-latest: a threshold belongs to the version it was
# measured against.
JEV_MODEL=jev-1.13.0
# Jev probability (0-1) an article must reach to be sent to Claude.
# Placeholder, NOT measured: pick it from the threshold sweep printed by
#   TYPESAFE_API_KEY=... go test ./internal/extract/ -run TestEval -v
# Out-of-range or unparseable values fall back to the default.
JEV_MIN_PROBABILITY=0.5

# Endpoint overrides for local smoke runs against fake servers. Leave empty
# to use the real Anthropic and TypeSafe APIs.
EXTRACT_BASE_URL=
TYPESAFE_BASE_URL=

TRANSFER_WINDOW=summer-2026

# Auth (cmd/api only — the worker binaries don't set or need these).
# AUTH_JWT_SECRET signs the Transfer-Scout session JWT issued after a
# successful Google sign-in. GOOGLE_CLIENT_ID is the OAuth Client ID the
# API verifies incoming Google ID tokens' audience against — it MUST
# exactly match transfer-scout-web's AUTH_GOOGLE_ID; a mismatch fails
# silently with a generic 401 on every login attempt.
AUTH_JWT_SECRET=
GOOGLE_CLIENT_ID=

# Neon's pooled endpoint does not reliably support the session-level locking and
# DDL that golang-migrate needs, so `make migrate-up` / `make migrate-down` run
# against the direct (unpooled) endpoint rather than DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
